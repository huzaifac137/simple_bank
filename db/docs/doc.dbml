Project simple_bank {
  database_type: 'PostgreSQL'
  Note: '''
    # Simple Bank Project Database
  '''
}


Table users as U {
  username varchar [not null , pk]
  hashed_password varchar [not null]
  full_name varchar [not null]
  email varchar [unique , not null]
  createdAt timestampz [not null , default: `now()`]
  password_changed_at timestampz [not null , default: `0001-01-01 00:00:00Z`]
}

Table "accounts" {
  "id" BIGINT [pk, not null, increment]
  "owner" varchar [not null , ref: > U.username]
  "balance" bigint [not null]
  "currency" varchar [not null]
  "createdAt" timestamp [not null, default: `now()`]

  Indexes {
    owner
    (owner , currency) [unique]
  }
}

Table "entries" {
  "id" BIGINT [pk, not null, increment]
  "account_id" bigint [not null]
  "amount" bigint [not null, note: 'Can be positive or negative']
  "createdAt" timestamp [not null, default: `now()`]

  Indexes {
    account_id
  }
}

Table "transfers" {
  "id" BIGINT [pk, not null, increment]
  "from_account_id" bigint [not null]
  "to_account_id" bigint [not null]
  "amount" bigint [not null, note: 'Must be positive']
  "createdAt" timestamp [not null, default: `now()`]

  Indexes {
    from_account_id
    to_account_id
    (from_account_id, to_account_id)
  }
}

Ref:"accounts"."id" < "entries"."account_id"

Ref:"accounts"."id" < "transfers"."from_account_id"

Ref:"accounts"."id" < "transfers"."to_account_id"
